def amortization_report():
    principal = float(input("Loan amount: $"))
    annual_rate = float(input("Annual interest rate (%): "))
    years = int(input("Years: "))
    output_file = input("Output filename: ")

    monthly_rate = annual_rate / 100 / 12
    num_payments = years * 12

    payment = principal * (
        monthly_rate * (1 + monthly_rate) ** num_payments
    ) / ((1 + monthly_rate) ** num_payments - 1)

    balance = principal

    with open(output_file, "w") as file:
        file.write("Payment Schedule\n")
        file.write(f"Monthly Payment: ${payment:.2f}\n\n")
        file.write(
            f"{'Pmt#':<6}{'Payment':<12}{'Interest':<12}"
            f"{'Principal':<12}{'Balance':<12}\n"
        )

        for payment_num in range(1, num_payments + 1):
            interest = balance * monthly_rate
            principal_paid = payment - interest
            balance -= principal_paid

            if balance < 0:
                balance = 0

            file.write(
                f"{payment_num:<6}{payment:<12.2f}"
                f"{interest:<12.2f}{principal_paid:<12.2f}"
                f"{balance:<12.2f}\n"
            )

    print("Report written to", output_file)

amortization_report()